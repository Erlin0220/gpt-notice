{
  "name": "gpt-notice",
  "version": "0.8.1",
  "private": true,
  "description": "减少 ChatGPT Web 频繁请求与接口 429，优化消息队列、通知和扩展交互体验。",
  "scripts": {
    "build": "node scripts/build-extension.js",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/core.test.js tests/background.test.js tests/static.test.js",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test tests/e2e/extension-load.spec.js",
    "e2e:chrome:prepare": "node scripts/e2e-current-chrome.mjs prepare",
    "e2e:chrome:endpoint": "node scripts/e2e-current-chrome.mjs endpoint",
    "e2e:chrome:probe": "node scripts/e2e-current-chrome.mjs probe",
    "e2e:headed": "set PW_HEADLESS=0&& playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
