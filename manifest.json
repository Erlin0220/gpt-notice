{
  "manifest_version": 3,
  "name": "ChatGPT Queue 与完成提醒",
  "version": "0.8.0",
  "description": "保留原生 ChatGPT 输入体验，提供本地 Queue、完成通知与来源明确的 GPT-6 用量记录。",
  "minimum_chrome_version": "120",
  "permissions": ["notifications", "storage", "tabs", "webRequest"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "ChatGPT Queue 与完成提醒",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/chatgpt.png", "32": "icons/chatgpt.png", "48": "icons/chatgpt.png", "128": "icons/chatgpt.png" }
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["queue-core.js", "usage-core.js", "chatgpt-dom.js", "queue-ui.js", "content.js"],
    "run_at": "document_idle"
  }],
  "icons": { "16": "icons/chatgpt.png", "32": "icons/chatgpt.png", "48": "icons/chatgpt.png", "128": "icons/chatgpt.png" }
}
